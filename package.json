{
  "name": "pi-tools",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "bin": {
    "browser-cli": "./bin/browser-cli.mjs",
    "agent-bridge": "./bin/agent-bridge.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/*.ts"
    ],
    "skills": [
      "./skills"
    ],
    "themes": [
      "./themes"
    ]
  },
  "scripts": {
    "check": "biome check . && npm run typecheck",
    "fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.agent-bridge.json",
    "test:browser-cli": "node --test tests/browser-cli/*.test.mjs",
    "agent-bridge": "bun --no-env-file bin/agent-bridge.mjs",
    "test:agent-bridge": "bun test tests/agent-bridge/*.test.ts && node --experimental-transform-types --test tests/agent-bridge/*.test.mjs tests/agent-bridge/telegram/*.test.mjs",
    "test:bot": "node --experimental-transform-types --test tests/bot/*.test.mjs",
    "test:extensions": "node --experimental-transform-types --test tests/extensions/*.test.mjs"
  },
  "dependencies": {
    "playwright": "1.63.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/bun": "^1.3.0",
    "@types/node": "22.18.6",
    "typebox": "1.1.38",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
